{
  "name": "uruvam",
  "version": "0.1.0-alpha.3",
  "description": "Visual-first local product UI studio powered by OpenCode Go",
  "author": "Praveen Juge",
  "repository": {
    "type": "git",
    "url": "https://github.com/praveenjuge/uruvam.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "electron-forge start",
    "build": "vite build --config vite.renderer.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.main.config.ts",
    "package": "pnpm fetch:opencode && pnpm dlx node@24.19.0 ./node_modules/@electron-forge/cli/dist/electron-forge.js package --arch=arm64",
    "make": "pnpm fetch:opencode && pnpm dlx node@24.19.0 scripts/rebuild-maker-native.mjs && pnpm dlx node@24.19.0 ./node_modules/@electron-forge/cli/dist/electron-forge.js make --arch=arm64",
    "release:manifest": "node scripts/create-update-manifest.mjs",
    "fetch:opencode": "node scripts/fetch-opencode.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:packaged": "playwright test --config playwright.packaged.config.ts",
    "test:live": "vite build --config vite.live.config.ts && node .vite/live/live.mjs",
    "test:live:vision": "URUVAM_LIVE_ENTRY=scripts/live-vision-only.mjs vite build --config vite.live.config.ts && node .vite/live/live.mjs",
    "quality": "bash scripts/run-quality-gates.sh",
    "validate:skill": "node scripts/validate-skill.mjs"
  },
  "dependencies": {
    "@opencode-ai/client": "0.0.0-next-17055",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.16",
    "axe-core": "4.13.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "lucide-react": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@opencode-ai/cli-darwin-arm64": "0.0.0-next-17055",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "electron": "43.3.0",
    "eslint": "10.0.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
